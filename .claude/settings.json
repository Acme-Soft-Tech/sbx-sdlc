{
  "$comment": "Shared in git on purpose. EvaFi today has only a personal settings.local.json, which is why none of its policy is enforced anywhere but one laptop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-branch.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-env.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sms-guard.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/production-gate.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-freeze.sh" }
        ]
      }
    ]
  }
}
